    "dev:analyze": "ANALYZE=true npm run build",
    "dev:profile": "NODE_ENV=development NEXT_PUBLIC_PROFILE=true npm run dev",
    "dev:clean": "rm -rf .next node_modules/.cache",
    "dev:reset": "npm run dev:clean && npm install && npm run dev",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:check": "node scripts/quality-check.js",
    "quality:fix": "npm run format && npm run lint -- --fix",
    "biome:check": "biome check .",
    "biome:fix": "biome check --fix .",
    "prepare": "husky"
