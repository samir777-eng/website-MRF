# 🎓 MRF Educational Platform - Environment Variables
# ============================================
# IMPORTANT: Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!
# ============================================

# =============================================================================
# 🔐 AUTHENTICATION & SECURITY (REQUIRED)
# =============================================================================

# NextAuth.js secret key for session encryption
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a strong, unique secret in production!
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# NextAuth.js URL - Your application's base URL
# Development: http://localhost:3003
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3003"

# JWT secret key for token signing
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a different secret than NEXTAUTH_SECRET!
JWT_SECRET="your-jwt-secret-key-here-generate-with-openssl-rand-base64-32"

# =============================================================================
# 💾 DATABASE CONFIGURATION (REQUIRED)
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:mypassword@localhost:5432/mrf_edu_db
DATABASE_URL="postgresql://username:password@localhost:5432/mrf_edu_db"

# =============================================================================
# 📧 EMAIL CONFIGURATION (REQUIRED FOR NOTIFICATIONS)
# =============================================================================

# Gmail SMTP server settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# Your Gmail address
SMTP_USER="your-email@gmail.com"

# Gmail App Password (NOT your regular Gmail password!)
# How to generate:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Other (Custom name)"
# 5. Enter "MRF Educational Platform"
# 6. Copy the 16-character password (remove spaces)
SMTP_PASS="your-16-character-app-password"

# =============================================================================
# 📊 ANALYTICS & MONITORING (OPTIONAL)
# =============================================================================

# Google Analytics 4 Measurement ID
# How to get:
# 1. Go to https://analytics.google.com/
# 2. Create a new GA4 property
# 3. Copy the Measurement ID (format: G-XXXXXXXXXX)
# Leave empty to disable analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Performance metrics endpoint
NEXT_PUBLIC_PERFORMANCE_ENDPOINT="http://localhost:3003/api/performance"

# Webhook URL for monitoring alerts (optional)
MONITORING_WEBHOOK_URL=""

# =============================================================================
# 🚀 FEATURE FLAGS (REQUIRED)
# =============================================================================

# Enable/disable features globally (set to "true" or "false")
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING="true"
NEXT_PUBLIC_ENABLE_ERROR_REPORTING="true"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"

# Mock Service Worker (MSW) for API mocking
# IMPORTANT: Set to "false" in production!
NEXT_PUBLIC_MSW_ENABLED="false"

# =============================================================================
# 🌐 API CONFIGURATION (OPTIONAL)
# =============================================================================

# Base API URL (when switching from MSW to real backend)
# NEXT_PUBLIC_API_URL=https://api.mrredaelfarouk.com
# NEXT_PUBLIC_API_VERSION=v1

# =============================================================================
# 🔐 OAUTH PROVIDERS (OPTIONAL)
# =============================================================================

# Google OAuth (if implementing social login)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth
# FACEBOOK_CLIENT_ID=your_facebook_client_id
# FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Google Tag Manager
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Hotjar (for user behavior analytics)
# NEXT_PUBLIC_HOTJAR_ID=your_hotjar_id
# NEXT_PUBLIC_HOTJAR_SV=your_hotjar_snippet_version

# Sentry (for error monitoring)
# NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here
# SENTRY_ORG=your_sentry_org
# SENTRY_PROJECT=your_sentry_project
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Vercel Analytics (if deploying to Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# =============================================================================
# 💾 Database Configuration
# =============================================================================

# PostgreSQL (for production backend)
# DATABASE_URL=postgresql://username:password@localhost:5432/mrf_education
# DATABASE_POOL_SIZE=10

# MongoDB (alternative database option)
# MONGODB_URI=mongodb://localhost:27017/mrf_education
# MONGODB_DB_NAME=mrf_education

# Redis (for caching and sessions)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# =============================================================================
# 📧 Email & Communication
# =============================================================================

# SMTP Configuration for transactional emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=noreply@mrredaelfarouk.com

# SendGrid (alternative email service)
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=noreply@mrredaelfarouk.com

# Twilio (for SMS notifications)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# ☁️ Cloud Storage & CDN
# =============================================================================

# AWS S3 (for video and file storage)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=mrf-education-content

# Cloudinary (for image and video processing)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Vercel Blob (for file storage on Vercel)
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# =============================================================================
# 🎥 Video & Media Services
# =============================================================================

# Vimeo (for video hosting)
# VIMEO_ACCESS_TOKEN=your_vimeo_access_token
# VIMEO_CLIENT_ID=your_vimeo_client_id
# VIMEO_CLIENT_SECRET=your_vimeo_client_secret

# YouTube (for video integration)
# YOUTUBE_API_KEY=your_youtube_api_key

# JW Player (alternative video platform)
# JWPLAYER_API_KEY=your_jwplayer_api_key
# JWPLAYER_API_SECRET=your_jwplayer_api_secret

# =============================================================================
# 🔔 Push Notifications
# =============================================================================

# Firebase Cloud Messaging
# NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
# FIREBASE_ADMIN_SDK_KEY=your_firebase_admin_sdk_key

# OneSignal (alternative push notification service)
# NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
# ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# =============================================================================
# 💳 Payment Processing
# =============================================================================

# Stripe (for subscription payments)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal (alternative payment processor)
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Fawry (Egyptian payment gateway)
# FAWRY_MERCHANT_CODE=your_fawry_merchant_code
# FAWRY_SECURITY_KEY=your_fawry_security_key

# =============================================================================
# 🌍 Internationalization & Localization
# =============================================================================

# Default locale and supported locales
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SUPPORTED_LOCALES=ar,en

# Translation service (for automated translations)
# GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
# DEEPL_API_KEY=your_deepl_api_key

# =============================================================================
# 🔧 Development & Testing
# =============================================================================

# Environment
NODE_ENV=development

# Next.js configuration
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=MRF Educational Platform

# Mock Service Worker (MSW) configuration
# NEXT_PUBLIC_MSW_ENABLED=true

# Testing configuration
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# CYPRESS_BASE_URL=http://localhost:3000

# =============================================================================
# 📱 PWA Configuration
# =============================================================================

# PWA settings
NEXT_PUBLIC_PWA_NAME=موقع الأستاذ رضا الفاروق
NEXT_PUBLIC_PWA_SHORT_NAME=MRF Education
NEXT_PUBLIC_PWA_DESCRIPTION=منصة تعليمية لتعلم اللغة العربية
NEXT_PUBLIC_PWA_THEME_COLOR=#1e40af
NEXT_PUBLIC_PWA_BACKGROUND_COLOR=#ffffff

# =============================================================================
# 🎯 Feature Flags
# =============================================================================

# Feature toggles for gradual rollout
# NEXT_PUBLIC_FEATURE_SOCIAL_LOGIN=true
# NEXT_PUBLIC_FEATURE_OFFLINE_MODE=true
# NEXT_PUBLIC_FEATURE_PUSH_NOTIFICATIONS=true
# NEXT_PUBLIC_FEATURE_LEADERBOARDS=true
# NEXT_PUBLIC_FEATURE_ACHIEVEMENTS=true
# NEXT_PUBLIC_FEATURE_DARK_MODE=true

# =============================================================================
# 🚀 Deployment Configuration
# =============================================================================

# Vercel deployment
# VERCEL_URL=your_vercel_deployment_url
# VERCEL_ENV=development

# Custom domain
# NEXT_PUBLIC_DOMAIN=mrredaelfarouk.com

# CDN configuration
# NEXT_PUBLIC_CDN_URL=https://cdn.mrredaelfarouk.com

# =============================================================================
# 📊 Performance & Monitoring
# =============================================================================

# Performance monitoring
# NEXT_PUBLIC_PERFORMANCE_MONITORING=true

# Bundle analyzer
# ANALYZE=false

# =============================================================================
# 🔒 Security Headers
# =============================================================================

# Content Security Policy
# CSP_REPORT_URI=https://your_csp_report_endpoint

# =============================================================================
# 📝 Logging
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log format (json, pretty)
LOG_FORMAT=pretty

# =============================================================================
# 🎨 Customization
# =============================================================================

# Brand colors (if customizable)
# NEXT_PUBLIC_PRIMARY_COLOR=#1e40af
# NEXT_PUBLIC_SECONDARY_COLOR=#f59e0b
# NEXT_PUBLIC_ACCENT_COLOR=#10b981

# =============================================================================
# 📚 Content Management
# =============================================================================

# Headless CMS (if using Strapi, Contentful, etc.)
# STRAPI_API_URL=http://localhost:1337
# STRAPI_API_TOKEN=your_strapi_api_token

# CONTENTFUL_SPACE_ID=your_contentful_space_id
# CONTENTFUL_ACCESS_TOKEN=your_contentful_access_token

# =============================================================================
# 🤖 AI & Machine Learning
# =============================================================================

# OpenAI (for AI-powered features)
# OPENAI_API_KEY=your_openai_api_key

# Google AI (for translation and content analysis)
# GOOGLE_AI_API_KEY=your_google_ai_api_key

# =============================================================================
# 📞 Support & Help Desk
# =============================================================================

# Intercom (for customer support)
# NEXT_PUBLIC_INTERCOM_APP_ID=your_intercom_app_id

# Zendesk (alternative support platform)
# ZENDESK_SUBDOMAIN=your_zendesk_subdomain
# ZENDESK_API_TOKEN=your_zendesk_api_token

# =============================================================================
# 🔍 Search & Indexing
# =============================================================================

# Algolia (for search functionality)
# NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
# NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your_algolia_search_key
# ALGOLIA_ADMIN_API_KEY=your_algolia_admin_key

# Elasticsearch (alternative search solution)
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=your_elasticsearch_password

# =============================================================================
# 🎯 QUICK START GUIDE
# =============================================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Generate secrets:
#    openssl rand -base64 32  # For NEXTAUTH_SECRET
#    openssl rand -base64 32  # For JWT_SECRET
# 3. Set up Gmail App Password (see instructions above)
# 4. Update DATABASE_URL with your PostgreSQL credentials
# 5. Create Google Analytics property (optional)
# 6. Update all placeholder values
# 7. Restart your development server: npm run dev

# =============================================================================
# ✅ PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# ✅ All secrets are generated with openssl rand -base64 32
# ✅ NEXTAUTH_URL points to your production domain
# ✅ DATABASE_URL points to production database
# ✅ Gmail App Password is configured correctly
# ✅ Google Analytics ID is set (if using analytics)
# ✅ NEXT_PUBLIC_MSW_ENABLED is set to "false"
# ✅ All sensitive values are kept secret
# ✅ .env.local is in .gitignore (never commit!)
# ✅ Environment variables are set in your hosting platform
#    (Vercel, Netlify, AWS, etc.)

